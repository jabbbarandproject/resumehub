# Copy to .env and fill in. All values are baked into the build.
VITE_SITE_URL=https://yourdomain.com
VITE_CONTACT_EMAIL=abduljabbar1572817@gmail.com

# Google AdSense (leave empty until approved)
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT=

# Google Analytics 4 (optional)
VITE_GA_ID=

# Premium: checkout link from Stripe Payment Links / Gumroad / Lemon Squeezy / Paddle
VITE_CHECKOUT_URL=
VITE_PREMIUM_PRICE=$9
VITE_PREMIUM_PRICE_VALUE=9
VITE_PREMIUM_CURRENCY=USD

# License checking, pick ONE:
# 1) Your serverless endpoint (recommended). See serverless/verify-license.js
VITE_LICENSE_API=
# 2) Hashed keys (simple, not secure). Create with: npm run hash-key -- YOUR-KEY
VITE_LICENSE_KEY_HASHES=
